DJANGO_ENV=production
# CONTAINER SETUP
DB_CONTAINER=decos_db_production
WEBAPP_CONTAINER=decos_webapp_production
DJANGO_DIR=/app/decos/decos_webapp
POSTGRES_WEBAPP_DB=decos_webapp_db
POSTGRES_METADATA_DB=decos_metadata_db
POSTGRES_USER=decos
POSTGRES_PASSWORD=changeme
POSTGRES_VOLUME=decos_postgres_data
WEB_APP_PORT=8080
# DJANGO/WAGTAIL SETTINGS
WAGTAIL_HOSTNAME=localhost
DJANGO_SETTINGS_MODULE=decos_webapp.settings.production
WAGTAILADMIN_BASE_URL=https://localhost
DECOS_ALLOWED_HOSTS=localhost
DECOS_SECRET_KEY=changeme
CSRF_TRUSTED_ORIGINS=['https://localhost']
# External services
AUTHENTIK_SECRETS_HOST_FILE=.secrets/authentik_secrets.txt
MINIO_SECRETS_HOST_FILE=.secrets/minio_secrets.txt
# Set django superuser
SUPERUSER_NAME=admin
SUPERUSER_EMAIL=changeme
SUPERUSER_PASSWORD=changeme

# Nginx configuration
SERVER_NAME=localhost
UPSTREAM_HOST=webapp
UPSTREAM_PORT=8080
SSL_CERT=/etc/nginx/certs/server.crt
SSL_KEY=/etc/nginx/certs/server.key
STATIC_ROOT=/app/decos/decos_webapp/staticfiles
MEDIA_ROOT=/app/decos/decos_webapp/media
WORKER_PROCESSES=1
WORKER_CONNECTIONS=1024

