DJANGO_ENV=development
# CONTAINER SETUP
DB_CONTAINER=decos_db
WEBAPP_CONTAINER=decos_webapp
DJANGO_DIR=/app/decos/decos_webapp
POSTGRES_WEBAPP_DB=decos_webapp_db
POSTGRES_METADATA_DB=decos_metadata_db
POSTGRES_USER=decos
POSTGRES_PASSWORD=changeme
POSTGRES_VOLUME=decos_postgres_data_dev
WEB_APP_PORT=8080
DEBUGPY_PORT=5678
# DJANGO/WAGTAIL SETTINGS
DJANGO_SETTINGS_MODULE=decos_webapp.settings.dev
WAGTAILADMIN_BASE_URL=https://localhost
DECOS_ALLOWED_HOSTS=localhost
DECOS_SECRET_KEY=changeme
CSRF_TRUSTED_ORIGINS=['https://localhost']
MINIO_CLIENT_ID=changeme
MINIO_SECRET_TOKEN=changeme
# Set django superuser
SUPERUSER_NAME=admin
SUPERUSER_EMAIL=changeme
SUPERUSER_PASSWORD=changeme

